{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["tokenreview", "static"] },
        "existingSecret": { "type": "string" }
      }
    },
    "allowedHosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "allowedOrigins": { "type": "array", "items": { "type": "string", "pattern": "^(null|[a-z][a-z0-9+.-]*://.+)$" } },
    "redact": { "enum": ["strict", "standard", "off"] },
    "logLevel": { "enum": ["error", "warn", "info", "debug", "trace"] },
    "extraArgs": { "type": "array", "items": { "type": "string", "pattern": "^--" } },
    "clusterDomain": { "type": "string", "minLength": 1 },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "secretsMetadata": { "type": "boolean" },
        "extraRules": { "type": "array" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "resources": { "type": "object" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array" },
        "apiServerCIDRs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "extraEgress": { "type": "array" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
